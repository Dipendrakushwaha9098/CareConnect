// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?
  name      String
  role      String   @default("patient") // 'patient' | 'doctor'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patients  Patient[]
}

model Patient {
  id             String        @id @default(uuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  age            Int
  gender         String
  dosha          String?
  email          String?
  phone          String?
  bloodGroup     String?
  address        String?
  medicalHistory String?
  lastVisit      DateTime      @default(now())
  status         String        @default("Active")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
}

model Appointment {
  id           String   @id @default(uuid())
  patientId    String
  therapy      String
  date         String // Format YYYY-MM-DD
  time         String // Format HH:MM AM/PM
  notes        String?
  status       String   @default("Scheduled")
  cancelReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Treatment {
  id        String   @id @default(uuid())
  name      String
  category  String?  // E.g., 'Ayurveda', 'General Medicine', 'Physiotherapy'
  desc      String
  duration  String
  type      String?  // Replaces specific 'dosha' text to be more broad
  sessions  Int      @default(1)
  completed Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prescription {
  id        String   @id @default(uuid())
  patient   String
  doctor    String
  date      String
  medicines String   // JSON array as string
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id        String   @id @default(uuid())
  patient   String
  amount    String
  date      String
  paid      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicineReminder {
  id        String   @id @default(uuid())
  patientId String?
  name      String
  time      String   // E.g. "08:00 AM"
  freq      String   // E.g. "Once daily"
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model SymptomCheck {
  id         String   @id @default(uuid())
  patientId  String?
  symptoms   String
  diagnosis  String
  urgency    String
  specialist String
  createdAt  DateTime @default(now())
}

model TelemedicineSession {
  id          String   @id @default(uuid())
  patientName String
  doctorName  String
  roomName    String
  createdAt   DateTime @default(now())
}

model VoiceConsultationNote {
  id          String   @id @default(uuid())
  patientName String
  notes       String
  createdAt   DateTime @default(now())
}
