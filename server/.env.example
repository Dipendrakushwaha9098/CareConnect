# ==========================================
# CareConnect Backend Environment Configuration
# ==========================================

PORT=3001
DATABASE_URL="file:./dev.db"
JWT_SECRET="careconnect-super-secret-key-12345"

# File Storage Configuration
PRIVATE_UPLOAD_DIR="./uploads/private"
SIGNED_URL_EXPIRY_SECONDS=900

# Email (SMTP) Configuration for Appointment & Verification Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="CareConnect Medical <no-reply@careconnect.com>"

# SMS / OTP Verification (Twilio Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
